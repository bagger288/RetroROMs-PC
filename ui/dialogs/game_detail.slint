import { Theme } from "../theme.slint";
import { GameCardData, RomVersionData, ScreenshotData } from "../models.slint";
import { ActionButton, PillButton } from "../widgets.slint";
import { ScrollView } from "std-widgets.slint";

export component GameDetailModal inherits Rectangle {
    in-out property <bool> is-open: false;
    in-out property <GameCardData> game;
    in-out property <[RomVersionData]> rom-versions: [];
    in-out property <[ScreenshotData]> screenshots: [];
    in-out property <bool> is-loading-versions: false;

    callback close();
    callback download-version(string); // fid
    callback play();
    callback reveal();
    callback view-cover();
    callback view-screenshot(string); // url

    width: 100%;
    height: 100%;
    background: #000000bb;

    TouchArea {
        clicked => { root.close(); }
    }

    // Modal Card
    Rectangle {
        width: Math.min(parent.width - 40px, 760px);
        height: Math.min(parent.height - 40px, 620px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.border-radius-md;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.border-light;

        TouchArea {
            // Block clicks from closing modal
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            // Header Row: Title & Close Button
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                Text {
                    text: "📖 Информация об игре: " + root.game.title;
                    font-size: 15px;
                    font-weight: 700;
                    color: #ffffff;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                PillButton {
                    text: "✖";
                    active: false;
                    clicked => { root.close(); }
                }
            }

            // Divider
            Rectangle { height: 1px; background: Theme.border; }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 12px;

                    // 1. Top Section: Cover + Metadata
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;

                        // Cover box
                        Rectangle {
                            width: 125px;
                            height: 155px;
                            border-radius: Theme.border-radius-sm;
                            background: #0a0f18;
                            clip: true;

                            if root.game.has-cover : Image {
                                width: 100%;
                                height: 100%;
                                source: root.game.cover-image;
                                image-fit: contain;
                            }

                            if !root.game.has-cover : Text {
                                text: "🎮";
                                font-size: 36px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => { root.view-cover(); }
                                mouse-cursor: pointer;
                            }
                        }

                        // Metadata Column
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.game.title;
                                font-size: 16px;
                                font-weight: 700;
                                color: #ffffff;
                            }

                            if root.game.original-title != "" : Text {
                                text: root.game.original-title;
                                font-size: 11.5px;
                                color: Theme.text-secondary;
                            }

                            // Badges Row
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                // Console
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: #0078d730;
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 6px;
                                        Text { text: root.game.console-name; font-size: 11px; font-weight: 700; color: Theme.primary; vertical-alignment: center; }
                                    }
                                }

                                // Genre
                                if root.game.genre != "" : Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: Theme.surface;
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 6px;
                                        Text { text: root.game.genre; font-size: 11px; color: #ffffff; vertical-alignment: center; }
                                    }
                                }

                                // Year
                                if root.game.year != "" : Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: Theme.surface;
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 6px;
                                        Text { text: "📅 " + root.game.year; font-size: 11px; color: Theme.text-secondary; vertical-alignment: center; }
                                    }
                                }

                                // Rating
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: #ffb30030;
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 6px;
                                        Text { text: "★ " + root.game.rating-str; font-size: 11px; font-weight: 700; color: Theme.secondary; vertical-alignment: center; }
                                    }
                                }
                            }

                            if root.game.developer != "" || root.game.publisher != "" : Text {
                                text: (root.game.developer != "" ? ("Разработчик: " + root.game.developer) : "") +
                                      (root.game.publisher != "" ? (" • Издатель: " + root.game.publisher) : "");
                                font-size: 11px;
                                color: Theme.text-muted;
                            }

                            // Downloaded play / reveal buttons
                            if root.game.is-downloaded : HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                ActionButton {
                                    text: "Запустить игру";
                                    icon: "▶";
                                    is-play: true;
                                    clicked => { root.play(); }
                                }

                                PillButton {
                                    text: "📁 Открыть папку";
                                    active: false;
                                    clicked => { root.reveal(); }
                                }
                            }
                        }
                    }

                    // 2. Screenshots Section
                    if root.screenshots.length > 0 : VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "Скриншоты:";
                            font-size: 12px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            for ss in root.screenshots : Rectangle {
                                width: 160px;
                                height: 110px;
                                border-radius: Theme.border-radius-sm;
                                background: #0a0f18;
                                clip: true;

                                if ss.has-img : Image {
                                    width: 100%;
                                    height: 100%;
                                    source: ss.img;
                                    image-fit: contain;
                                }

                                TouchArea {
                                    clicked => { root.view-screenshot(ss.url); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    // 3. Description
                    if root.game.description != "" : VerticalLayout {
                        spacing: 4px;

                        Text {
                            text: "Описание игры:";
                            font-size: 12px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        Text {
                            text: root.game.description;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }

                    // 4. ROM Versions / Downloads
                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "Доступные версии ROM файла:";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        if root.is-loading-versions : Text {
                            text: "⏳ Загрузка ревизий игры с Emu-Land.net…";
                            font-size: 12px;
                            color: Theme.primary;
                        }

                        if !root.is-loading-versions && root.rom-versions.length == 0 : HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            ActionButton {
                                text: "Скачать основной ROM (" + root.game.file-size + ")";
                                icon: "⬇";
                                clicked => { root.download-version("default"); }
                            }
                        }

                        for ver in root.rom-versions : Rectangle {
                            height: 38px;
                            border-radius: Theme.border-radius-sm;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: ver.name;
                                    font-size: 12px;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: ver.category != "" ? ver.category : ver.region-or-type;
                                    font-size: 11px;
                                    color: Theme.subname-color;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: ver.size;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                ActionButton {
                                    text: "Скачать";
                                    icon: "⬇";
                                    clicked => { root.download-version(ver.fid); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
