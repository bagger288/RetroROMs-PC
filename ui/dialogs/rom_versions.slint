import { Theme } from "../theme.slint";
import { GameCardData, RomVersionData } from "../models.slint";
import { ActionButton, PillButton } from "../widgets.slint";
import { ScrollView } from "std-widgets.slint";

export component RomVersionsModal inherits Rectangle {
    in-out property <bool> is-open: false;
    in-out property <GameCardData> game;
    in-out property <[RomVersionData]> rom-versions: [];
    in-out property <bool> is-loading: false;

    callback close();
    callback download-version(string); // fid

    width: 100%;
    height: 100%;
    background: #000000bb;

    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: Math.min(parent.width - 40px, 680px);
        height: Math.min(parent.height - 40px, 480px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.border-radius-md;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.border-light;

        TouchArea {
            // Block
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            // Header
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "💾 Выбор версии ROM: " + root.game.title;
                        font-size: 15px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                    Text {
                        text: root.game.console-name + (root.game.genre != "" ? (" • " + root.game.genre) : "");
                        font-size: 11px;
                        color: Theme.primary;
                    }
                }

                PillButton {
                    text: "✖";
                    active: false;
                    clicked => { root.close(); }
                }
            }

            Rectangle { height: 1px; background: Theme.border; }

            if root.is-loading : VerticalLayout {
                alignment: center;
                height: 160px;
                spacing: 8px;
                Text {
                    text: "⏳ Запрос доступных ревизий игры с Emu-Land.net…";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Обычно это занимает 1-2 секунды";
                    font-size: 11px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }

            if !root.is-loading && root.rom-versions.length == 0 : VerticalLayout {
                alignment: center;
                height: 160px;
                spacing: 12px;

                Text {
                    text: "Отдельный список ревизий не найден. Доступен основной архив:";
                    font-size: 12.5px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }

                ActionButton {
                    text: "⬇ Скачать основной ROM (" + root.game.file-size + ")";
                    icon: "⬇";
                    clicked => { root.download-version("default"); }
                }
            }

            if !root.is-loading && root.rom-versions.length > 0 : ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 6px;

                    for ver in root.rom-versions : Rectangle {
                        height: 42px;
                        border-radius: Theme.border-radius-sm;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: ver.name;
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                height: 20px;
                                border-radius: 4px;
                                background: #0078d720;
                                y: (parent.height - self.height) / 2;
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px;
                                    Text {
                                        text: ver.category != "" ? ver.category : ver.region-or-type;
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: Theme.primary;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: ver.size;
                                font-size: 11px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }

                            ActionButton {
                                text: "Скачать";
                                icon: "⬇";
                                font-size: 11px;
                                clicked => { root.download-version(ver.fid); }
                            }
                        }
                    }
                }
            }
        }
    }
}
