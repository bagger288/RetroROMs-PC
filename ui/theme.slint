    in-out property <color> surface-hover: #182234;
    in-out property <color> border: #1c283c;
    in-out property <color> border-light: #25354e;

    // Accent Colors
    in-out property <color> primary: #0078d7;
    in-out property <color> primary-hover: #1084e3;
    in-out property <color> primary-active: #0060b0;
