import { Theme } from "theme.slint";

export component PillButton inherits Rectangle {
    in-out property <string> text: "";
    in-out property <string> icon: "";
    in-out property <bool> active: false;
    in-out property <int> badge-count: 0;
    in-out property <length> h-padding: 12px;
    in-out property <length> v-padding: 6px;
    in-out property <length> font-size: 12px;
    in-out property <bool> bold: false;

    callback clicked();

    border-radius: Theme.border-radius-pill;
    background: root.active ? (touch.pressed ? Theme.primary-active : (touch.has-hover ? Theme.primary-hover : Theme.primary))
                           : (touch.pressed ? Theme.surface-hover : (touch.has-hover ? Theme.surface-hover : Theme.surface));
    border-width: root.active ? 0px : 1px;
    border-color: root.active ? transparent : (touch.has-hover ? Theme.border-light : Theme.border);

    HorizontalLayout {
        padding-left: root.h-padding;
        padding-right: root.h-padding;
        padding-top: root.v-padding;
        padding-bottom: root.v-padding;
        spacing: 6px;
        alignment: center;

        if root.icon != "" : Text {
            text: root.icon;
            font-size: root.font-size + 1px;
            color: root.active ? #ffffff : Theme.text-secondary;
            vertical-alignment: center;
        }

        if root.text != "" : Text {
            text: root.text;
            font-size: root.font-size;
            font-weight: (root.bold || root.active) ? 700 : 500;
            color: root.active ? #ffffff : (touch.has-hover ? #ffffff : Theme.text-secondary);
            vertical-alignment: center;
        }

        if root.badge-count > 0 : Rectangle {
            background: Theme.secondary;
            border-radius: 9px;
            height: 18px;
            min-width: 18px;

            HorizontalLayout {
                padding-left: 5px;
                padding-right: 5px;
                alignment: center;
                Text {
                    text: root.badge-count;
                    font-size: 10px;
                    font-weight: 700;
                    color: #000000;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component ActionButton inherits Rectangle {
    in-out property <string> text: "Кнопка";
    in-out property <string> icon: "";
    in-out property <bool> is-play: false;
    in-out property <length> font-size: 11.5px;

    callback clicked();

    border-radius: Theme.border-radius-sm;
    background: root.is-play ? (touch.pressed ? #00c864 : (touch.has-hover ? #00f07c : Theme.success))
                             : (touch.pressed ? Theme.primary-active : (touch.has-hover ? Theme.primary-hover : Theme.primary));

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 4px;
        alignment: center;

        if root.icon != "" : Text {
            text: root.icon;
            font-size: root.font-size + 1px;
            color: root.is-play ? #000000 : #ffffff;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            font-size: root.font-size;
            font-weight: 700;
            color: root.is-play ? #000000 : #ffffff;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component FavoriteButton inherits Rectangle {
    in-out property <bool> is-favorite: false;
    callback clicked();

    width: 28px;
    height: 26px;
    border-radius: Theme.border-radius-sm;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-light : Theme.border;

    Text {
        text: root.is-favorite ? "♥" : "♡";
        font-size: 13px;
        color: root.is-favorite ? Theme.heart-active : (touch.has-hover ? #ffffff : Theme.text-muted);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component SearchBar inherits Rectangle {
    in-out property <string> text <=> input.text;
    in-out property <string> placeholder: "Поиск по всей библиотеке EmuLand (Mario, Sonic...)";
    callback accepted(string);
    callback text-changed(string);
    callback cleared();

    height: 36px;
    border-radius: Theme.border-radius-pill;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.primary : Theme.border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        alignment: center;

        Text {
            text: "🔍";
            font-size: 13px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }

        input := TextInput {
            horizontal-stretch: 1;
            font-size: 12px;
            color: Theme.text-primary;
            vertical-alignment: center;
            single-line: true;

            edited => {
                root.text-changed(self.text);
            }
            accepted => {
                root.accepted(self.text);
            }
        }

        if input.text == "" && !input.has-focus : Text {
            text: root.placeholder;
            font-size: 12px;
            color: Theme.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if input.text != "" : Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: clear-touch.has-hover ? Theme.surface-hover : transparent;

            Text {
                text: "✖";
                font-size: 11px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            clear-touch := TouchArea {
                clicked => {
                    input.text = "";
                    root.text-changed("");
                    root.cleared();
                }
                mouse-cursor: pointer;
            }
        }
    }
}

export component ProgressBar inherits Rectangle {
    in-out property <float> progress: 0.0; // 0.0 .. 1.0

    height: 8px;
    border-radius: 4px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: parent.width * Math.max(0.0, Math.min(1.0, root.progress));
        border-radius: 4px;
        background: Theme.primary;
    }
}
